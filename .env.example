# Copy to .env and fill in. .env is gitignored and excluded from the image.
#
#   cp .env.example .env
#   docker compose up -d db        # pgvector/pgvector:pg17
#   .venv/bin/python -m pytest -q

# ---------- database ----------
# Password for the compose `db` service. Must match what you use below.
DB_PASSWORD=devpassword

# LOCAL DEV: the app running on your host talks to the published port.
# IN DOCKER: docker-compose.yml overrides this with the compose network name
# (postgresql://gaia:...@db:5432/gaia) — service `environment:` beats `env_file:`.
DATABASE_URL=postgresql://gaia:devpassword@127.0.0.1:5432/gaia

# Where the test suite creates and drops its per-process database.
# conftest defaults to exactly this, so you only need it if you differ.
TEST_ADMIN_DSN=postgresql://gaia:devpassword@127.0.0.1:5432/gaia

# ---------- models ----------
# claude-opus-5 is the default. claude-sonnet-5 is ~2.5x cheaper and a
# reasonable downgrade if transcription quality holds; do not use
# claude-sonnet-4-6, which is both older and pricier than sonnet-5.
MODEL=claude-opus-5
ANTHROPIC_API_KEY=sk-ant-...

# Embeddings for semantic memory. voyage-3.5-lite, 1024 dims.
VOYAGE_API_KEY=pa-...

# ---------- whatsapp ----------
# Not needed for the test suite — only to talk to Meta for real.
WA_ACCESS_TOKEN=EAAG...          # permanent token, Business Settings > System Users
WA_APP_SECRET=...                # Meta app secret; verifies webhook signatures
WA_VERIFY_TOKEN=any-string-you-invent
WA_PHONE_NUMBER_ID=1234567890    # WhatsApp > API Setup

# ---------- production only ----------
# Caddy provisions TLS for this hostname. Unused in local dev.
DOMAIN=agent.gaia.example.com

# ---------- backups (production only) ----------
# DigitalOcean Spaces bucket and region endpoint for nightly pg_dump uploads.
# See deploy/README.md. Not needed for local dev or the test suite.
SPACES_BUCKET=gaia-backups
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
# Spaces access key pair, generated in the DO control panel. The `aws` CLI
# in the `backup` service reads these two exact variable names natively.
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
