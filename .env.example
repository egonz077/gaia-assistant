# Copy to .env and fill in. .env is gitignored and excluded from the image.
#
#   cp .env.example .env
#   # local dev only — production publishes no database port (see deploy/README.md)
#   docker compose -f docker-compose.yml -f deploy/compose.dev.yml up -d db
#   .venv/bin/python -m pytest -q

# ---------- database ----------
# Password for the compose `db` service. There is no default in
# docker-compose.yml: a missing DB_PASSWORD makes `docker compose` fail loudly
# rather than quietly standing up a brokerage's client book behind a password
# published in this repo.
#
#   PRODUCTION: generate one, and change it here before the first `up`.
#       openssl rand -base64 32
#   LOCAL DEV: any value. `devpassword` is what the test suite's default DSN
#       expects, so use that unless you also set TEST_ADMIN_DSN below.
DB_PASSWORD=CHANGE_ME_openssl_rand_base64_32

# Replace `devpassword` in both URLs below with whatever you set above.
#
# LOCAL DEV: the app running on your host talks to the port published by
# deploy/compose.dev.yml.
# IN DOCKER: docker-compose.yml overrides this with the compose network name
# (postgresql://gaia:...@db:5432/gaia) — service `environment:` beats `env_file:`.
DATABASE_URL=postgresql://gaia:devpassword@127.0.0.1:5432/gaia

# Where the test suite creates and drops its per-process database.
# conftest defaults to exactly this, so you only need it if you differ.
TEST_ADMIN_DSN=postgresql://gaia:devpassword@127.0.0.1:5432/gaia

# ---------- models ----------
# Two workloads, two settings. Do not use claude-sonnet-4-6, which is both
# older and pricier than sonnet-5.
#
# MODEL is the butler: the agent loop that transcribes photographed
# handwriting, picks tools and does date arithmetic. It stays on Opus — that
# transcription is the hardest thing this product does and the reason it
# exists, so it is the last place to trade quality for price.
MODEL=claude-opus-5
#
# DIGEST_MODEL is the morning composer: one short paragraph from a ~300-token
# JSON payload, no tools, no images, nothing to reason about. Measured on a
# realistic payload, sonnet-5 produced $0.0032/digest against opus-5's $0.0092
# — 65% less — holding format, the nudge_count wording and the due time.
#
# claude-haiku-4-5 is cheaper again (~$0.0012) but needs a code change and a
# second look: it REJECTS output_config.effort with a 400 ("This model does not
# support the effort parameter"), which compose_digest sends, and on the same
# payload it wrote ALL-CAPS headers against the prompt's plain-text rule.
DIGEST_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=sk-ant-...

# Embeddings for semantic memory. voyage-3.5-lite, 1024 dims.
VOYAGE_API_KEY=pa-...

# ---------- whatsapp ----------
# Not needed for the test suite — only to talk to Meta for real.
WA_ACCESS_TOKEN=EAAG...          # permanent token, Business Settings > System Users
WA_APP_SECRET=...                # Meta app secret; verifies webhook signatures
WA_VERIFY_TOKEN=any-string-you-invent
WA_PHONE_NUMBER_ID=1234567890    # WhatsApp > API Setup

# ---------- production only ----------
# Caddy provisions TLS for this hostname. It is the only variable the caddy
# service receives, and compose requires it, so set it to anything non-empty
# locally if you ever bring the full stack up.
DOMAIN=agent.gaia.example.com

# ---------- backups (production only) ----------
# DigitalOcean Spaces bucket and region endpoint for nightly pg_dump uploads.
# See deploy/README.md. Not needed for local dev or the test suite.
SPACES_BUCKET=gaia-backups
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
# Spaces access key pair, generated in the DO control panel. The `aws` CLI
# in the `backup` service reads these two exact variable names natively.
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
